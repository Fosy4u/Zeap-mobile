<resources>

    <!-- Base application theme. -->
    <!-- The app is designed for light mode only, so we lock it to a Light theme
         (instead of DayNight) and disable auto force-dark. This stops the OS from
         inverting native views (e.g. TextInput text) into unreadable colors when
         the device is in dark mode. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

</resources>
